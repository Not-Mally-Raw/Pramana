# Five-agent API key mapping for Pramana scripted fleet.
# Current quick-swap setup:
# - Agent 1-5 -> Groq keys
#
# Copy this file to scripts/agents/.env.agents and paste your real keys.
# The fleet runner auto-loads scripts/agents/.env.agents by default.

# Agent 1: TreasuryBot (Groq)
AGENT_1_PROVIDER=groq
AGENT_1_API_KEY=
AGENT_1_MODEL=llama-3.1-8b-instant

# Agent 2: KeeperBot (Groq)
AGENT_2_PROVIDER=groq
AGENT_2_API_KEY=
AGENT_2_MODEL=llama-3.1-8b-instant

# Agent 3: ArbBot (Groq)
AGENT_3_PROVIDER=groq
AGENT_3_API_KEY=
AGENT_3_MODEL=llama-3.1-8b-instant

# Agent 4: RebalancerBot (Groq)
AGENT_4_PROVIDER=groq
AGENT_4_API_KEY=
AGENT_4_MODEL=llama-3.1-8b-instant

# Agent 5: InjectionAttacker (Groq)
AGENT_5_PROVIDER=groq
AGENT_5_API_KEY=
AGENT_5_MODEL=llama-3.1-8b-instant

# Optional frontend runtime defaults for org-scoped dashboard.
# (Set these in frontend/.env.local for persistent dashboard behavior.)
# NEXT_PUBLIC_PRAMANA_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_PRAMANA_ORG_ID=demo-prof
# NEXT_PUBLIC_PRAMANA_JWT=
