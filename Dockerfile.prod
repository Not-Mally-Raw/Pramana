# Pramana Production Dockerfile
# Multi-stage build for optimized production images

# Stage 1: Python base
FROM python:3.12-slim as python-base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Stage 2: Build frontend
FROM node:18-alpine as node-builder

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci --prefer-offline --no-audit

COPY frontend/ .
RUN npm run build

# Stage 3: Production image
FROM python:3.12-slim

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=python-base /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=python-base /usr/local/bin /usr/local/bin

# Copy application code
COPY core/ core/
COPY utils/ utils/
COPY scripts/ scripts/
COPY contracts/ contracts/
COPY tests/ tests/
COPY pramana_cli.py .
COPY .env.example .

# Copy built frontend
COPY --from=node-builder /app/frontend/.next frontend/.next
COPY --from=node-builder /app/frontend/public frontend/public
COPY --from=node-builder /app/frontend/package.json frontend/

# Create runtime directories
RUN mkdir -p /app/data/.logs /app/data/.pids

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Environment defaults
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    LOG_LEVEL=INFO \
    DEBUG=false

# Expose ports
EXPOSE 8000 3000

# Entrypoint script
COPY <<'EOF' /entrypoint.sh
#!/bin/bash
set -e

echo "🚀 Starting Pramana..."

# Validate required env vars
if [ -z "$GROQ_API_KEY" ]; then
    echo "⚠️  Warning: GROQ_API_KEY not set. Agent operations may be limited."
fi

if [ -z "$JWT_SECRET" ]; then
    echo "Generating JWT_SECRET..."
    export JWT_SECRET=$(openssl rand -hex 32)
fi

if [ -z "$ATTESTATION_HMAC_SECRET" ]; then
    echo "Generating ATTESTATION_HMAC_SECRET..."
    export ATTESTATION_HMAC_SECRET=$(openssl rand -hex 32)
fi

# Start API server
echo "Starting FastAPI server on port $PORT..."
export PYTHONPATH=/app
exec uvicorn core.app:app --host 0.0.0.0 --port $PORT
EOF

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
