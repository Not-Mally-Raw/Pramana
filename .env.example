# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...your_groq_api_key_here

# ── Network ───────────────────────────────────────────────────────────────────
# Options: anvil (local) | sepolia (testnet)
NETWORK=anvil
ANVIL_RPC=http://127.0.0.1:8545

# Alchemy WebSocket (only needed for Sepolia)
ALCHEMY_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ── Smart Contracts (filled after `pramana deploy`) ───────────────────────────
ORCHESTRATOR_ADDR=
GUARDIAN_ADDR=
SBT_ADDR=
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80  # Anvil default key

# ── Databases ────────────────────────────────────────────────────────────────
SQLITE_PATH=data/pramana.db
DUCKDB_PATH=data/analytics.duckdb
CHROMA_PATH=data/chroma

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
DEFAULT_ORG_ID=default

# ── Alerts (optional) ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=

# ── Debug ────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
